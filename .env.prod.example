# Production env for the single-VPS deploy. Copy to .env.prod (bootstrap.sh does this and fills
# the random secrets). Placeholders only: never commit a real .env.prod.
# __GENERATE__ values are replaced by bootstrap.sh; FILL-IN values need a human.

# --- Public address ---
# Hostname users open. Default: <server-ip>.sslip.io (e.g. 203.0.113.10.sslip.io), no DNS needed.
# Own domain: point an A record for it AND s3.<it> at the server IP first.
DOMAIN=203.0.113.10.sslip.io
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com
WEB_ORIGIN=https://203.0.113.10.sslip.io
CORE_API_URL=http://core-api:8000
AI_SERVICE_URL=http://ai-service:8001

# --- PostgreSQL ---
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
CORE_DB_USER=core
CORE_DB_PASSWORD=__GENERATE__
CORE_DB_NAME=core
CORE_APP_DB_USER=core_app
CORE_APP_DB_PASSWORD=__GENERATE__
CORE_ERASER_LOGIN=
CORE_ERASER_PASSWORD=
AI_DB_USER=ai
AI_DB_PASSWORD=__GENERATE__
AI_DB_NAME=ai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (RustFS on the same VPS, behind Caddy at s3.<DOMAIN>) ---
S3_ENDPOINT=https://s3.203.0.113.10.sslip.io
S3_PUBLIC_ENDPOINT=https://s3.203.0.113.10.sslip.io
UPLOAD_ORIGIN=https://s3.203.0.113.10.sslip.io
S3_REGION=us-east-1
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
S3_BUCKET=essity-files

# --- Service-to-service secrets (>= 32 chars) ---
AI_SERVICE_TOKEN=__GENERATE__
WEB_TO_CORE_TOKEN=__GENERATE__
LOG_HASH_KEY=__GENERATE__
# Caddy is one proxy in front of web.
WEB_TRUSTED_PROXY_HOPS=1

# --- Email: Gmail with an App Password (FILL IN) ---
# Google Account -> Security -> 2-Step Verification on -> App passwords -> create one (16 chars).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=your.address@gmail.com

# --- LLM ---
# anthropic (needs ANTHROPIC_API_KEY) or disabled (grading answers 503). `fake` is refused in production.
AI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=FILL-IN-API-KEY
# Empty = api.anthropic.com. Set to a compatible proxy if you use one.
ANTHROPIC_BASE_URL=
AI_QUOTA_DAILY_USD=
AI_QUOTA_MONTHLY_USD=
AI_QUOTA_HARD_CAP_FACTOR=
