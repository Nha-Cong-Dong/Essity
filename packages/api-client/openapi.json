    "/v1/auth/password-reset": {
      "post": {
        "description": "Email a one-hour reset link if the account exists; the same answer either way (AC5).",
        "operationId": "request_password_reset_v1_auth_password_reset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailBody"
              }
            }
          },
          "required": true
