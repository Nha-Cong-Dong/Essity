                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Password Reset"
      }
    },
    "/v1/auth/password-reset/confirm": {
      "post": {
        "description": "Set a new password from a reset link (ADR-0021): the old password and every session end,\nthe email counts as verified. Done in the request's transaction, with the token's use.",
        "operationId": "confirm_password_reset_v1_auth_password_reset_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
