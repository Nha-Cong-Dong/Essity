# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
# Chỉ đặt giá trị giả/mặc định cho local ở đây; secret thật nằm trong secret manager.

# --- PostgreSQL (hai database, hai user riêng — ADR-0007) ---
POSTGRES_SUPERUSER_PASSWORD=change-me-local
CORE_DB_USER=core
CORE_DB_PASSWORD=change-me-local
CORE_DB_NAME=core
AI_DB_USER=ai
AI_DB_PASSWORD=change-me-local
AI_DB_NAME=ai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (RustFS khi local, R2 trên production) ---
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=change-me-local
S3_SECRET_KEY=change-me-local-too
S3_BUCKET=essity-files

# --- Giao tiếp giữa các dịch vụ ---
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=change-me-local-at-least-32-characters
CORE_API_URL=http://core-api:8000
# web gửi token này cho core-api (header X-Service-Token) để core-api tin IP người dùng (ADR-0022).
# Bắt buộc, ≥ 32 ký tự. Compose đưa cùng giá trị cho core-api làm CORE_WEB_TOKEN.
WEB_TO_CORE_TOKEN=change-me-local-web-token-at-least-32-chars
# Origin duy nhất được gửi request thay đổi dữ liệu tới web (kiểm header Origin, ADR-0014).
# Local mở http://localhost:3000; mở bằng 127.0.0.1 thì đăng nhập sẽ bị từ chối (403).
WEB_ORIGIN=http://localhost:3000
# Số proxy đứng trước web cộng thêm vào X-Forwarded-For. 0 = trình duyệt gọi thẳng web (Compose).
# Đặt 0 khi có reverse proxy thật thì mọi người dùng chung một IP: vài lần sai mật khẩu
# sẽ khóa tạm cả site. Production bắt buộc đặt tường minh.
WEB_TRUSTED_PROXY_HOPS=0
# Mở /design-preview ngoài development: chỉ đúng "1" mới mở (giá trị khác vẫn 404).
# WEB_DESIGN_PREVIEW=1
# Khóa băm IP trong log bảo mật của core-api. Local để trống được (mỗi lần chạy tự sinh);
# ngoài local bắt buộc, ≥ 32 ký tự ngẫu nhiên.
LOG_HASH_KEY=

# --- Email (Mailpit khi local) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@localhost

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Google OAuth (giai đoạn M5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
