{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essity.invalid/contracts/events/submission.processed.v1.schema.json",
  "title": "submission.processed.v1",
  "description": "ai → core: the submission is processed; the key names the session-result.v2 file (drafts).",
  "$ref": "envelope.schema.json",
  "unevaluatedProperties": false,
  "properties": {
    "event_type": {
      "const": "submission.processed.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_id",
        "study_session_id",
        "run_id",
        "result_key"
      ],
      "properties": {
        "submission_id": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "study_session_id": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "run_id": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "result_key": {
          "$ref": "envelope.schema.json#/$defs/object_key"
        }
      }
    }
  }
}
