{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essity.invalid/contracts/events/session.failed.v1.schema.json",
  "title": "session.failed.v1",
  "description": "ai → core: processing the session failed.",
  "$ref": "envelope.schema.json",
  "unevaluatedProperties": false,
  "properties": {
    "event_type": {
      "const": "session.failed.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_session_id",
        "run_id",
        "reason"
      ],
      "properties": {
        "study_session_id": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "run_id": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "reason": {
          "enum": [
            "unreadable",
            "llm_unavailable",
            "internal_error"
          ]
        }
      }
    }
  }
}
