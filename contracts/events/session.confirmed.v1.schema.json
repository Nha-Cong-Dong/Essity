{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://essity.invalid/contracts/events/session.confirmed.v1.schema.json",
  "title": "session.confirmed.v1",
  "description": "core → ai: a study session was confirmed; ai-service reads the notes and splits units. Carries the subject's existing units so duplicates merge without a call back (ADR-0006 point 6). Never the learner's description (layer 1).",
  "$ref": "envelope.schema.json",
  "unevaluatedProperties": false,
  "properties": {
    "event_type": {
      "const": "session.confirmed.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_session_id",
        "subject_id",
        "ranges",
        "notes",
        "existing_units"
      ],
      "properties": {
        "study_session_id": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "subject_id": {
          "$ref": "envelope.schema.json#/$defs/uuid"
        },
        "ranges": {
          "description": "Page ranges the session covered, FILE pages, 1-based; `first <= last` is checked by core-api before it enqueues (JSON Schema cannot say it). Empty: notes only (US-02 AC10).",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "first",
              "last",
              "depth"
            ],
            "properties": {
              "document_id": {
                "$ref": "envelope.schema.json#/$defs/uuid"
              },
              "first": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5000
              },
              "last": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5000
              },
              "depth": {
                "enum": [
                  "deep",
                  "skim",
                  "unclear"
                ]
              }
            }
          }
        },
        "notes": {
          "description": "Files of notes the learner added, in the learner's own prefix.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_key",
              "mime"
            ],
            "properties": {
              "object_key": {
                "$ref": "envelope.schema.json#/$defs/object_key"
              },
              "mime": {
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "application/pdf",
                  "text/plain",
                  "text/markdown"
                ]
              }
            }
          }
        },
        "existing_units": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "title",
              "summary"
            ],
            "properties": {
              "unit_id": {
                "$ref": "envelope.schema.json#/$defs/uuid"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "summary": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  }
}
